@urlBase = http://localhost:8787/api
@contentType = application/json

// Ajustá productId/locationId a los ids devueltos por los catálogos.
@productId = 4
@locationId = 1

// MOVEMENT TYPE

// list all
GET {{urlBase}}/movement-type

###

// get by code (se normaliza a mayúsculas)
GET {{urlBase}}/movement-type/ENTRy

###

// LOCATION

// list all
GET {{urlBase}}/locations

###

// get by id (entero positivo)
GET {{urlBase}}/locations/1

###

// PRODUCT

// create
POST {{urlBase}}/products HTTP/1.1
Content-Type: {{contentType}}

{
    "sku": "gif030ycii"
}

###

// list all
GET {{urlBase}}/products

###

// get by sku
GET {{urlBase}}/products/GIF030YCII

###

// delete (409 si tiene movimientos o stock asociado)
DELETE {{urlBase}}/products/GIF030YCII

###

// MOVEMENT

// create entry
POST {{urlBase}}/movements HTTP/1.1
Content-Type: {{contentType}}

{
    "productId": {{productId}},
    "locationId": {{locationId}},
    "movementTypeCode": "ENTRY",
    "quantity": 10,
    "note": "compra"
}

###

// create exit (409 si el stock quedaría negativo)
POST {{urlBase}}/movements HTTP/1.1
Content-Type: {{contentType}}

{
    "productId": {{productId}},
    "locationId": {{locationId}},
    "movementTypeCode": "EXIT",
    "quantity": 3
}

###

// list all (más reciente primero)
GET {{urlBase}}/movements

###

// get by id
GET {{urlBase}}/movements/1

###

// list by location
GET {{urlBase}}/movements/location/{{locationId}}

###

// STOCK

// list all (filtros opcionales: ?productId=..&locationId=..)
GET {{urlBase}}/stock

###

// stock de un producto en todas las ubicaciones
GET {{urlBase}}/stock/product/{{productId}}

###

// stock de una ubicación
GET {{urlBase}}/stock/location/{{locationId}}

###

// stock de un producto en una ubicación
GET {{urlBase}}/stock/{{productId}}/{{locationId}}

###

// reconstruir el stock desde los movimientos
POST {{urlBase}}/stock/recalculate

###
