{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-inventario",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "d1-local-con-drizzle",
      // El database_id es privado: se inyecta desde .env en wrangler.generated.jsonc
      // mediante `npm run cf:config` (lo ejecutan deploy y los comandos remotos).
      "migrations_dir": "drizzle"
    }
  ],
  // "ai": {
  //   "binding": "AI"
